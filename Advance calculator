class Calculator {
public:
    double a, b;

    void calculate() {
        int choice;
        cout << "1.Add  2.Subtract  3.Multiply\n";
        cout << "4.Divide  5.Power  6.Square Root\n";
        cout << "Enter your choice: ";
        cin >> choice;

        if (choice == 6) {
            cout << "Enter a number: ";
            cin >> a;
            if (a >= 0)
                cout << "Result = " << sqrt(a);
            else
                cout << "Invalid input";
            return;
        }

        cout << "Enter two numbers: ";
        cin >> a >> b;

        switch (choice) {
        case 1: cout << "Result = " << a + b; break;
        case 2: cout << "Result = " << a - b; break;
        case 3: cout << "Result = " << a * b; break;
        case 4:
            if (b != 0) cout << "Result = " << a / b;
            else cout << "Cannot divide by zero";
            break;
        case 5: cout << "Result = " << pow(a, b); break;
        default: cout << "Invalid choice";
        }
    }
};

int main() {
    Calculator c;
    c.calculate();
    return 0;
}
